{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlos-andrade/STOCKS/blob/main/AÇÕES/VERIFICADOR_EVENTOS_SOCIETARIOS/schemas/evento-societario.schema.json",
  "title": "STOCKS Corporate Action Event",
  "type": "object",
  "required": [
    "event_id",
    "ticker",
    "event_type",
    "post_event_shares_per_pre_event_share",
    "effective_date",
    "source_url",
    "source_type",
    "verification_status"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9]{4,12}$"},
    "company": {"type": ["string", "null"]},
    "event_type": {"enum": ["GRUPAMENTO", "DESDOBRAMENTO", "BONIFICACAO"]},
    "post_event_shares_per_pre_event_share": {"type": "number", "exclusiveMinimum": 0},
    "announcement_date": {"type": ["string", "null"], "format": "date"},
    "effective_date": {"type": "string", "format": "date"},
    "record_date": {"type": ["string", "null"], "format": "date"},
    "last_cum_date": {"type": ["string", "null"], "format": "date"},
    "ex_date": {"type": ["string", "null"], "format": "date"},
    "source_url": {"type": "string", "format": "uri"},
    "source_type": {"enum": ["RI_EMISSOR", "B3", "CVM", "OUTRA_FONTE"]},
    "document_title": {"type": ["string", "null"]},
    "verification_status": {"enum": ["PENDENTE", "VERIFICADO", "REJEITADO"]},
    "verified_by": {"type": ["string", "null"]},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "GRUPAMENTO"}}},
      "then": {"properties": {"post_event_shares_per_pre_event_share": {"exclusiveMaximum": 1}}
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "DESDOBRAMENTO"}}},
      "then": {"properties": {"post_event_shares_per_pre_event_share": {"exclusiveMinimum": 1}}
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "BONIFICACAO"}}},
      "then": {"properties": {"post_event_shares_per_pre_event_share": {"exclusiveMinimum": 1}}
      }
    }
  ],
  "additionalProperties": false
}
